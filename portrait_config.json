{
  "hardware": {
    "target": "raspberry_pi_5",
    "storage_mount_path": "/mnt/portrait",
    "models_dir": "/mnt/portrait/models",
    "cache_dir": "/mnt/portrait/cache",
    "audio_dir": "/mnt/portrait/audio",
    "logs_dir": "/mnt/portrait/logs"
  },
  "conversation_mode": "auto",
  "gemini_live": {
    "enabled": true,
    "model": "gemini-3.1-flash-live-preview",
    "voice_name": "Charon",
    "api_key_env": "GEMINI_API_KEY",
    "max_daily_tokens": 250000,
    "max_session_tokens": 40000,
    "storage_file": "token_usage.json",
    "quota_fallback_text": "My celestial communications are depleted for today! I shall converse with thee through local enchantments instead.",
    "response_voice": "piper",
    "text_model": "gemini-3.5-flash-lite",
    "max_output_tokens": 128,
    "timeout_seconds": 12.0,
    "turn_timeout_seconds": 30.0,
    "retry_cooldown_seconds": 30.0
  },
  "state_machine": {
    "wake_confirm_frames": 3,
    "wake_confirm_timeout_seconds": 1.5,
    "silence_timeout_seconds": 5.5,
    "max_listen_duration_seconds": 15.0,
    "max_consecutive_silence": 2,
    "cooldown_duration_seconds": 8.0,
    "presence_loss_frames": 5,
    "presence_loss_cooldown_seconds": 1.0,
    "presence_loss_farewell": "Farewell, wanderer..."
  },
  "vision": {
    "driver": "hailo",
    "confidence_threshold": 0.55,
    "poll_interval_seconds": 0.1,
    "camera_backend": "auto",
    "camera_device_index": 0,
    "camera_width": 640,
    "camera_height": 480,
    "camera_fps": 15,
    "analysis_width": 320
  },
  "llm": {
    "driver": "llama_client",
    "endpoint_url": "http://127.0.0.1:8080/v1/chat/completions",
    "model_name": "gemma-4-e2b-instruction",
    "temperature": 0.35,
    "max_tokens": 48,
    "timeout_seconds": 90.0,
    "connect_timeout_seconds": 5.0,
    "history_turn_limit": 2,
    "cache_prompt": true,
    "disable_reasoning": true,
    "empty_response_text": "The castle spirits stole my answer. Ask once more, brave visitor!",
    "system_prompt": "You are Wilhelm, a bold eccentric forest guardian and noble warrior in an enchanted portrait. Answer in one lively spoken sentence under 20 words.",
    "greeting_prompt": "Ah, a visitor arrives before my frame! State your business, noble wanderer!"
  },
  "stt": {
    "driver": "local_stt",
    "engine": "faster_whisper",
    "model_size": "tiny.en",
    "language": "en",
    "device": "cpu",
    "compute_type": "int8",
    "vad_filter": true,
    "energy_threshold": 300,
    "dynamic_energy_threshold": true,
    "ambient_calibration_seconds": 0.3,
    "microphone_device_index": null,
    "microphone_name": "",
    "sample_rate": null,
    "chunk_size": 1024,
    "arecord_device": "",
    "pause_threshold": 1.4,
    "non_speaking_duration": 0.5,
    "phrase_threshold": 0.15,
    "cpu_threads": 2,
    "allow_online_fallback": false,
    "local_files_only": false
  },
  "tts": {
    "driver": "piper",
    "piper_binary_path": "/mnt/portrait/models/piper/piper",
    "model_path": "/mnt/portrait/models/piper/en_US-ryan-medium.onnx",
    "model_config_path": "/mnt/portrait/models/piper/en_US-ryan-medium.onnx.json",
    "speaker_id": 0,
    "length_scale": 1.0,
    "noise_scale": 0.667,
    "noise_w": 0.8,
    "cache_enabled": true,
    "cache_dir": "/mnt/portrait/cache/tts",
    "audio_driver": "auto",
    "playback_sample_rate": 22050,
    "playback_channels": 1,
    "playback_buffer_size": 512,
    "runtime": "auto",
    "warmup_enabled": true,
    "synthesis_timeout_seconds": 30.0,
    "cache_max_entries": 128,
    "allow_synthetic_fallback": false,
    "voice_persona": "en_GB-alan-medium"
  },
  "renderer": {
    "window_title": "Harry Potter Talking Portrait (Wilhelm)",
    "width": 1024,
    "height": 768,
    "fullscreen": false,
    "fps": 30,
    "assets_dir": "assets",
    "asset_mode": "full_frames",
    "scene_fit": "contain",
    "use_display_resolution": true,
    "scene_director": {
      "enabled": true,
      "manifest": "wilhelm_asset_manifest.json",
      "video_memory_mb": 64,
      "decode_width": 960,
      "action_interval_min": 30,
      "action_interval_max": 65,
      "activity_interval_min": 180,
      "activity_interval_max": 420,
      "activities": [
        "reading",
        "tinkering"
      ],
      "preview": false,
      "schedule": {
        "enabled": false,
        "night_start_hour": 22,
        "night_end_hour": 7,
        "night_post_conversation_dwell_seconds": 90
      }
    },
    "sprite_files": {
      "base": "wilhelm_reading.png",
      "speaking_base": "wilhelm_desk_speaking_neutral.png",
      "wilhelm_reading": "wilhelm_reading.png",
      "wilhelm_desk_speaking_neutral": "wilhelm_desk_speaking_neutral.png",
      "wilhelm_tinker": "wilhelm_tinker.jpeg",
      "wilhelm_engaged_tinker": "wilhelm_engaged_tinker.png",
      "wilhelm_neutral": "wilhelm_neutral.jpeg",
      "empty_room": "empty_room.png",
      "eyes_closed": "wilhelm_desk_eyes_closed.png",
      "eyes_half": "wilhelm_desk_eyes_half.png",
      "mouth_1": "wilhelm_desk_speaking_neutral.png",
      "mouth_2": "wilhelm_desk_mouth_2.png",
      "mouth_3": "wilhelm_desk_mouth_3.png"
    },
    "camera_motion": false,
    "ambient_motes": true,
    "gaze_tracking_enabled": true,
    "gaze_sensitivity_x": 1.0,
    "gaze_sensitivity_y": 0.8,
    "viseme_crossfade": true,
    "viseme_crossfade_duration_ms": 35,
    "micro_saccades": true,
    "blink_easing": true,
    "blink_min_seconds": 2.2,
    "blink_max_seconds": 5.5,
    "blink_duration_ms": 180,
    "amplitude_threshold_mouth_2": 0.15,
    "amplitude_threshold_mouth_3": 0.45,
    "show_debug_hud": false,
    "show_camera_pip": false,
    "transitions": {
      "look_up": "transitions/look_up_frames",
      "return_to_book": "transitions/return_to_book_frames"
    },
    "idle_animations": {
      "page_flip": "idles/page_flip_frames",
      "tinker_box_study": "idles/tinker_study_frames",
      "get_out_book": "idles/get_out_book_frames",
      "get_out_tinker_box": "idles/get_out_tinker_box_frames"
    },
    "desk_view": {
      "enabled": true,
      "face_rel_x": 0.5756,
      "face_rel_y": 0.3333
    }
  },
  "logging": {
    "log_level": "INFO",
    "latency_profiling": true,
    "log_to_file": true
  }
}